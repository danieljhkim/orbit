/target

# Agent / tool state directories (Claude Code, Codex, Gemini, Grok Build)
.claude/
.codex/
.gemini/
.grok/

agentspace
!.claude/settings.json
!.claude/hooks/
!.codex/
.codex/*
!.codex/config.toml
!.codex/hooks/
.codex/hooks/*
!.codex/hooks/orbit-learning-reminder
!.gemini/
.gemini/*
!.gemini/settings.json
!.gemini/hooks/
.gemini/hooks/*
!.gemini/hooks/orbit-learning-reminder
!.grok/
!.grok/config.toml
!.grok/hooks/
# ...except the published plugin's MCP registration, which ships in the package.
!plugin/.mcp.json

# OS / editor
.DS_Store
.vscode/settings.json

# Scratch / session files
sessions
tmp
raw
examples.md
feature.md
feat.md
schema.md
critique.md

# Runtime state

orbit.db
orbit.db-shm
orbit.db-wal

# Benchmark run/task artifacts — regenerated per run, not committed
benchmarks/**/runs/**
benchmarks/**/tasks/**
# ADR artifacts are committed source-of-truth (adr-artifact ADR-002 amended,
# ADR-005); the SQLite index is rebuildable from the YAML+markdown. Other
# `.orbit/` state (tasks, runs, policies, audit DB, etc.) stays workspace-local.
.orbit/*
!.orbit/adrs/
.orbit/adrs/index.sqlite*
# Proposed / superseded ADRs are local-only until publication (ORB-10303);
# only accepted (and deleted) partitions travel with the repo. These
# exclusions must follow `!.orbit/adrs/` or the partitions get tracked anyway.
.orbit/adrs/proposed/
.orbit/adrs/superseded/
# Project learnings travel with the repo (ADR-003 in docs/design/project-learnings/4_decisions.md).
!.orbit/learnings/
# Auto-task definitions are git-versioned records (ORB-10149); the host-local
# last-fired cursor lives in `.orbit/state/` and stays ignored.
!.orbit/auto_tasks/
!.orbit/resources/
!.orbit/routines/
!.orbit/config.toml
# Lock files inside the re-included partitions stay ignored (ORB-10303).
.orbit/**/*.lock
.monodev/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
uv.lock

# Node
node_modules/
dist/
build/
.astro/

# direnv — per-repo env vars (holds secrets like ANTHROPIC_API_KEY)
.envrc
.direnv/
.gstack/
.locks
*.lock
.vscode
.grok
.gemini
.cowork-launch-env.txt